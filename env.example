# Server Configuration
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=phone_billing
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# QuickBooks Online Configuration
QBO_CLIENT_ID=your_qbo_client_id
QBO_CLIENT_SECRET=your_qbo_client_secret
QBO_REDIRECT_URI=http://localhost:3001/auth/qbo/callback
QBO_ENVIRONMENT=sandbox
QBO_ACCOUNT_ID=your_qbo_account_id
QBO_SCOPE=com.intuit.quickbooks.accounting
QBO_WEBHOOK_VERIFIER=your_qbo_webhook_verifier_secret

# Genesys Cloud Configuration
GENESYS_BASE_URL=https://api.mypurecloud.com
GENESYS_CLIENT_ID=your_genesys_client_id
GENESYS_CLIENT_SECRET=your_genesys_client_secret
GENESYS_ORG_ID=your_genesys_organization_id

# Billing Configuration
BILLING_CURRENCY=USD
BILLING_TIMEZONE=America/Los_Angeles
BILLING_ITEM_ID=
BILLING_ITEM_NAME=
BILLING_TAX_CODE=TAX

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# Email/Slack Alerts (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ALERT_EMAIL=alerts@yourcompany.com

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:3000

# Kill Switch
KILL_SWITCH_ENABLED=false
KILL_SWITCH_REASON= 